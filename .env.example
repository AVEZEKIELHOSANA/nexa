# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The public key: "anon" key or the newer "publishable" key. Safe in the browser ONLY because RLS is on.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER put the service-role / secret key here or in any NEXT_PUBLIC_ variable.
# It lives only in Supabase Edge Function secrets (set from Day 3 onwards).
